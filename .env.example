# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the initiiator marketing site.
#
# Copy this file to `.env.local` for local development, and set the same vars in
# your host's dashboard (e.g. Vercel → Settings → Environment Variables) for
# production.
#
# NOTE: every var here is prefixed NEXT_PUBLIC_, so it is inlined into the client
# bundle at BUILD time — it is NOT a secret, and changing it in production
# requires a redeploy to take effect.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical production URL, used for SEO (canonical tags, sitemap, robots,
# Open Graph / social-share image URLs). No trailing slash. Set this to your real
# domain at deploy; falls back to https://initiiator.com if unset.
NEXT_PUBLIC_SITE_URL=https://initiiator.com

# Launch switch. Controls the whole site (see src/lib/launch.ts):
#   "true"  → live/main mode: store buttons, full nav, Blog in footer.
#   unset / anything else → pre-launch mode: "Join the waitlist" CTAs, trimmed
#                           nav (Features + About Us + Contact), no Blog.
# Leave unset (or "false") until launch day; set to "true" to go live.
NEXT_PUBLIC_LAUNCHED=false

# Where waitlist signups are sent. This is Kit's public form endpoint:
#   https://app.kit.com/forms/<FORM_ID>/subscriptions
# It takes a plain POST and needs no API key, which is what makes it usable
# from a static site. NEVER put a Kit API *secret* in any NEXT_PUBLIC_ var —
# it is inlined into the browser bundle and would expose the whole subscriber
# list. Until this is set, the form says signups aren't open rather than
# failing. Only used in pre-launch mode.
#
# Kit's field names are exact and fail silently if wrong: the address must be
# `email_address`, and custom fields are `fields[<key>]` where <key> matches a
# NAMED custom field on the Kit form. An unnamed field posts as
# `fields[undefined]` and Kit discards the value. The form currently sends
# location, source and consent this way — if you swap the form or the provider,
# check those names still line up.
#
# Note: reCAPTCHA must stay OFF on the Kit form. It expects a token that only
# Kit's own embedded script produces, and we render our own form.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Where blog newsletter subscriptions are sent. Same idea as the waitlist
# endpoint, but deliberately a SEPARATE list: "email me at launch" and "send me
# weekly posts" are different consents and shouldn't be merged. Until this is
# set, the newsletter form says it isn't open yet rather than failing.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Real app-store listing URLs. Used only once NEXT_PUBLIC_LAUNCHED=true; the
# "Get on iPhone / Android" buttons link here. If left empty they fall back to
# "#", so set them before (or at) launch.
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
